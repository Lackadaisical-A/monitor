{
  "name": "biotech-signal-monitor",
  "version": "0.1.0",
  "private": true,
  "description": "Evidence-gated biotech catalyst monitor with AI analysis and APNs alerts",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "scan": "tsx src/cli/scan.ts",
    "seed:demo": "tsx src/cli/seed-demo.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/static": "latest",
    "better-sqlite3": "latest",
    "dotenv": "latest",
    "fast-xml-parser": "latest",
    "fastify": "latest",
    "jose": "latest",
    "openai": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/better-sqlite3": "latest",
    "@types/node": "latest",
    "tsx": "latest",
    "typescript": "latest",
    "vitest": "latest"
  }
}
