# Server
PORT=8787
HOST=127.0.0.1
DATABASE_PATH=./data/biotech-signal.db
CATALYST_MONITOR_ENABLED=false
BUYBACK_MONITOR_ENABLED=true
BUYBACK_STREAM_ENABLED=true
BUYBACK_DATA_DIR=./data/buyback
BUYBACK_PYTHON=python3
# Execution is opt-in; market-data keys never enable trading implicitly.
BUYBACK_TRADING_MODE=read_only
BUYBACK_CAPITAL=3000
BUYBACK_MONTHLY_DATA_COST=99
ALPACA_PAPER_API_KEY=
ALPACA_PAPER_SECRET_KEY=
# Owner-only live activation; leave blank during paper trading.
ALPACA_LIVE_API_KEY=
ALPACA_LIVE_SECRET_KEY=
BUYBACK_LIVE_CONFIRM=
SCAN_INTERVAL_SECONDS=120
SOURCE_TIMEOUT_MS=15000
LOG_LEVEL=info

# Protects the dashboard/API when exposed beyond localhost.
DASHBOARD_TOKEN=
# Entered once in the iPhone app to pair it with this server.
DEVICE_PAIRING_TOKEN=

# AI analysis. Without this key, the app uses a demo heuristic that can never
# issue an urgent notification.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# Source configuration
SOURCES_FILE=./config/sources.json
WATCHLIST_FILE=./config/watchlist.json
X_BEARER_TOKEN=
X_QUERY=("Phase 2" OR "Phase 3" OR topline OR "primary endpoint" OR FDA) (biotech OR pharma) -is:retweet -is:reply lang:en

# Reddit Data API access is restricted. Supply approved credentials only.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=BiotechSignal/0.1 (contact: you@example.com)
REDDIT_SUBREDDITS=biotech+Biotechplays

CLINICAL_TRIALS_ENABLED=true
SEC_ENABLED=true
SEC_USER_AGENT=BiotechSignal/0.1 you@example.com

# Alert policy. Keep dry-run on until you have reviewed real outputs.
ALERT_DRY_RUN=true
ALERT_MIN_MATERIALITY=88
ALERT_MIN_CONFIDENCE=0.86
ALERT_COOLDOWN_MINUTES=240

# Apple Push Notification service (server-side only)
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_BUNDLE_ID=com.example.BiotechSignal
APNS_PRIVATE_KEY_PATH=
APNS_ENVIRONMENT=sandbox
# Critical alerts require Apple's separately approved entitlement. Leave false
# unless the entitlement is present in the signed app and the user opted in.
APNS_ALLOW_CRITICAL=false
